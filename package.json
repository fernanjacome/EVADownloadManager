{
  "name": "eva-studio-2026",
  "version": "1.2.4",
  "description": "Gestor de Downloads XML para EVA",
  "author": "Fernando Jácome",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.js",
    "build": "vite build",
    "electron:build": "vite build --emptyOutDir false && electron-builder --publish never"
  },
  "build": {
    "appId": "com.eva.studio2026",
    "productName": "EVA Studio 2026",
    "asar": true,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!dist/win-unpacked{,/**}",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!dist/*.yml"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "electronLanguages": [
      "en-US",
      "es"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/lang-xml": "^6.1.0",
    "@novnc/novnc": "^1.6.0",
    "@uiw/codemirror-theme-eclipse": "^4.25.2",
    "@uiw/react-codemirror": "^4.25.2",
    "express": "^5.2.1",
    "html-to-image": "^1.11.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vite": "^5.4.10",
    "wait-on": "^9.0.1"
  }
}
